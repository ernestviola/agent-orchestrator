{
  "name": "agent-orchestrator",
  "version": "1.0.0",
  "description": "Multi-agent orchestrator CLI — an orchestrator LLM delegates scoped coding tasks to role-based sub-agents, each in its own isolated Docker container.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "agent-orchestrator": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "sandbox:build": "bash sandbox/build.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ernestviola/agent-orchestrator.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ernestviola/agent-orchestrator/issues"
  },
  "homepage": "https://github.com/ernestviola/agent-orchestrator#readme",
  "dependencies": {
    "dockerode": "^5.0.1"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
